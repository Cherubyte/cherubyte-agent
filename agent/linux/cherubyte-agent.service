[Unit]
Description=Cherubyte agent — local network sweep
Documentation=https://github.com/Cherubyte/cherubyte
After=network-online.target
Wants=network-online.target
# An always-on monitor should never sit dead because it restarted a few times
# in quick succession — keep trying rather than give up.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/cherubyte-agent
# Configuration lives in a file, not here: the same mechanism as the Windows and
# macOS installers, and it keeps the enrolment token out of `systemctl cat`.
EnvironmentFile=-/etc/cherubyte-agent/agent.env

# `always`, not `on-failure`: a monitor that stops sweeping is useless, so it
# comes back from a crash, an OOM kill or a stray signal too. Only an explicit
# `systemctl stop` keeps it down.
Restart=always
RestartSec=3

# Raw sockets for the ARP sweep (scapy) and the DHCP sniffer, and
# CAP_NET_BIND_SERVICE for the health endpoint — port 1002 is below 1024, so
# without it uvicorn dies at startup with EACCES and systemd restarts it
# forever. Everything else is dropped: the agent reads no files it did not
# write and makes only outbound HTTP.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/cherubyte-agent
StateDirectory=cherubyte-agent

[Install]
WantedBy=multi-user.target
