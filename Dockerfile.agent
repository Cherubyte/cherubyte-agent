# syntax=docker/dockerfile:1
#
# The Cherubyte agent: the half that touches the network.
#
# It sweeps a LAN and pushes what it saw to a panel. It holds no database and
# serves no UI, so it is also the only half that needs raw sockets and host
# networking — see the Docker section of the README.

FROM python:3.11-slim AS runtime

# iputils-ping -> the ICMP sweep, the internet probe, and the on-demand ping
#                 action shell out to `ping`
# iproute2     -> the kernel neighbour table is read with `ip -4 neigh show`
# snmp         -> optional SNMP reads (sysDescr, LLDP-MIB) shell out to snmpget/snmpwalk
# traceroute   -> the on-demand traceroute action shells out to `traceroute`
RUN apt-get update \
    && apt-get install -y --no-install-recommends iputils-ping iproute2 snmp traceroute tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY protocol/ protocol/
COPY agent/requirements.txt agent/requirements.txt
RUN pip install --no-cache-dir ./protocol \
    && pip install --no-cache-dir -r agent/requirements.txt

COPY agent/ agent/

# the key issued at enrolment lives here; mount it or the agent re-enrols,
# which needs a fresh token every restart
VOLUME ["/var/lib/cherubyte-agent"]

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CHERUBYTE_AGENT_HEALTH_HOST=0.0.0.0 \
    CHERUBYTE_AGENT_HEALTH_PORT=1002

EXPOSE 1002

# Degraded — enrolled but the panel is refusing reports — is a failure here on
# purpose: an agent nobody is listening to is not doing its job.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import os,sys,urllib.request; \
p=os.getenv('CHERUBYTE_AGENT_HEALTH_PORT','1002'); \
sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{p}/health',timeout=4).status==200 else 1)"

WORKDIR /app/agent
CMD ["python", "run.py"]
