[Unit]
Description=Cherubyte agent — varrimento da rede local
After=network-online.target
Wants=network-online.target
# An always-on monitor should never sit dead because it restarted a few times
# in quick succession — keep trying rather than give up.
StartLimitIntervalSec=0

[Service]
Type=simple
# The USER and ROOT placeholders below are filled in by
# scripts/install-agent-service.sh (it seds in the invoking user and repo path).
User=__CHERUBYTE_USER__
WorkingDirectory=__CHERUBYTE_ROOT__/agent
ExecStart=__CHERUBYTE_ROOT__/agent/.venv/bin/python run.py
# `always`, not `on-failure`: a monitor that stops sweeping is useless, so it
# comes back from a crash, an OOM kill, or a stray signal too. Only an explicit
# `systemctl stop` keeps it down.
Restart=always
RestartSec=3

# O agente precisa de raw sockets para o varrimento ARP (scapy) e para o
# sniffer de DHCP; CAP_NET_BIND_SERVICE para o bind na porta de saúde 1002.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
